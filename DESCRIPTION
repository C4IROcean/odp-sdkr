Package: odp
Type: Package
Title: Ocean Data Platform R SDK
Version: 0.1.7
Authors@R: c(
    person(given = "Max", family = "Romagnoli", role = c("aut", "cre"), email = "max.romagnoli@oceandata.earth"),
